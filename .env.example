# ==============================================================================
# CloudCompass - Environment Configuration
# ==============================================================================
# All configuration parameters are completely optional and pre-configured with
# production-grade, zero-configuration defaults.
#
# To customize, copy this file to .env.local:
#   cp .env.example .env.local
# ==============================================================================

# Telemetry API Base URL (AQI.in cluster)
VITE_AQI_API_BASE=https://apiserver.aqi.in

# Default location fallback if browser GPS geolocation is declined or unavailable
VITE_DEFAULT_CITY="New Delhi"
VITE_DEFAULT_COUNTRY="IN"
VITE_DEFAULT_LAT=28.6139
VITE_DEFAULT_LON=77.2090
