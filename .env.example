# ==============================================================================
# CloudCompass Environment Configuration
# ==============================================================================
# Copy this file to .env.local and populate the values for your local environment:
#   cp .env.example .env.local
#
# NOTE: CloudCompass is designed to work out-of-the-box with zero configuration!
# If VITE_OPENWEATHER_API_KEY is left blank, CloudCompass automatically utilizes
# real-time physical sensor telemetry and global high-resolution Open-Meteo feeds.
# ==============================================================================

# (Optional) OpenWeatherMap API Key for 5-day / 3-hour forecast feeds
# Register and obtain your free key at: https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=
